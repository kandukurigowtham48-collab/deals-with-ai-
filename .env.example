# ==========================================
# GOWTHAM DEALS - AI MANAGER CONFIGURATION
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=production

# ------------------------------------------
# 1. AFFILIATE MONETIZATION KEYS
# ------------------------------------------
AMAZON_ASSOCIATE_TAG=gowthamdeals-21
FLIPKART_AFFILIATE_ID=gowthamdeals
EARNKARO_API_TOKEN=your_earnkaro_token_here
BRANDED_DOMAIN=https://gdeals.in

# ------------------------------------------
# 2. YOUTUBE SHORTS PUBLISHING (Google Cloud)
# ------------------------------------------
# Instructions: https://console.cloud.google.com -> Enable YouTube Data API v3
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
YOUTUBE_AUTO_PIN_COMMENT=true

# ------------------------------------------
# 3. INSTAGRAM REELS (Meta Graph API)
# ------------------------------------------
# Instructions: https://developers.facebook.com -> Instagram Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ACCESS_TOKEN=your_long_lived_page_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ------------------------------------------
# 4. PRICE AUDITING & HISTORICAL CHECK
# ------------------------------------------
KEEPA_API_KEY=your_keepa_api_key_optional

# ------------------------------------------
# 5. OPTIONAL: HIGH-END NEURAL TTS (ElevenLabs / OpenAI)
# If omitted, system defaults to fast local synthetic voice (espeak-ng)
# ------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=your_openai_key_here

# ------------------------------------------
# 6. AUTONOMOUS SCHEDULER
# ------------------------------------------
AUTONOMOUS_MODE=true
SCHEDULE_INTERVAL_HOURS=4
MIN_DEAL_SCORE_FOR_VIDEO=85
